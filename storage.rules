rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Driver documents: licence / ID / vehicle reg / photo, namespaced by uid.
    match /applications/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      // Images only, max 10 MB.
      allow write: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Parcel proof-of-delivery (photo + signature). The assigned driver uploads;
    // the recorded URLs are validated server-side by deliverParcelStop. Readable
    // by any signed-in user (sender + driver + admin view the POD).
    match /parcels/{parcelId}/pod/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
